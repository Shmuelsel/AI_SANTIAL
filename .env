# ── Backend proxy target ──────────────────────────────────────────────────────
# NOT prefixed with VITE_ → never bundled into browser code.
# Read only by vite.config.js to set up the dev-server proxy.
BACKEND_URL=https://alarm-system-server-hqdpg3b3htceefgx.israelcentral-01.azurewebsites.net

# ── Browser-visible server URL ────────────────────────────────────────────────
# EMPTY = use the Vite proxy (all /api/ and /socket.io/ calls go to localhost,
#         Vite forwards them to BACKEND_URL — zero CORS issues).
# Set to a full URL only when frontend and backend are on different hosts in
# a non-proxied production deployment.
VITE_SERVER_URL=
VITE_API_BASE_URL=
VITE_WS_URL=

# Set to true to skip Firebase login during local development
VITE_DEV_BYPASS_AUTH=true

# Firebase — keep this file out of source control (.gitignore)
