# Exclude the virtual environment — this can be several GB
venv/

# edge_node/ is imported by central_server.video_worker (in-process pipeline),
# so it must be included in the server image. Only its standalone runner is excluded.
run_edge.py
run_debug.py
debug/

# Exclude the combined requirements file (server uses requirements.server.txt)
requirements.txt

# Exclude AI model weights — large binaries, not used by the server
*.pt
*.pth
*.onnx

# Exclude runtime-generated files
*.db
*.sqlite3
*.log
__pycache__/
*.pyc
*.pyo
