# Copy this file to .env (same directory) and adjust as needed.
# .env is git-ignored — never commit secrets.
# Every value below is optional; shared/config.py falls back to sane
# defaults for any variable left unset.

# ---------------------------------------------------------------------------
# Central Server
# ---------------------------------------------------------------------------
PORT=5000
CENTRAL_SERVER_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Video source — "live" expects assets/videos/live_demo.mp4, which is NOT
# included in this repo. "demo" loops one of the .mp4 files already checked
# into assets/videos/, so it works out of the box for local development.
# ---------------------------------------------------------------------------
DEFAULT_VIDEO_MODE=demo
# DEFAULT_DEMO_VIDEO_FILENAME=
# LIVE_VIDEO_PATH=

# ---------------------------------------------------------------------------
# Firebase Realtime Database (optional for local dev)
# Leave both unset to run in dry-run mode: alerts/rules/events are printed
# to the console instead of written to Firebase, and reads return empty.
# ---------------------------------------------------------------------------
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CRED_PATH=
# FIREBASE_DB_URL=

# ---------------------------------------------------------------------------
# Edge Node — only used if you run run_edge.py against a real RTSP camera.
# Not needed for local dev: the merged VideoWorker (used by run_server.py)
# reads directly from the local video files above.
# ---------------------------------------------------------------------------
# CAMERA_ID=CAM_1001
# RTSP_USER=admin
# RTSP_PASS=
# RTSP_IP=192.168.0.64
# RTSP_PORT=554
# RTSP_PATH=live/ch0
# YOLO_CONF_THRESHOLD=0.25
# DETECT_EVERY_N_FRAMES=3
# STREAM_FPS=20
# CAPTURE_WIDTH=640
# CAPTURE_HEIGHT=480

# ---------------------------------------------------------------------------
# Alert thresholds (tune detection sensitivity)
# ---------------------------------------------------------------------------
# CLIMBING_ALERT_THRESHOLD=50
# LOITERING_ALERT_THRESHOLD=70
# COMBINED_ALERT_THRESHOLD=50
# ZONE_DEFAULT_DWELL_SECONDS=120
